     "content": "\u010a\u010aFINALACTIONS:\u010apick(raw_meat_1)\u010aopen(grill_lid)\u010aplace(raw_meat_1,\u0120inside_grill)\u010apick(dish_rack)\u010aplace(dish_rack,\u0120serving_area)\u010aplace(raw_meat_1,\u0120plate_top)",
