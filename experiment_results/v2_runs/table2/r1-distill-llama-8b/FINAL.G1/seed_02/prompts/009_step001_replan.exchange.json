     "content": "\u010a\u010aFINALACTIONS:\u010apick(raw_meat_1)\u010aopen(grill_lid)\u010aplace(raw_meat_1,\u0120grill_side_area)\u010aplace(cooked_meat,\u0120plate_top)\u010apick(cooked_meat)\u010aplace(cooked_meat,\u0120serving_area)",
